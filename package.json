{
  "name": "crm-orum-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "CRM Orum — app de escritorio (CRM web + llamadas con transcripción local)",
  "main": "main.js",
  "author": "ORUM Consulting",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.orumconsulting.crm",
    "productName": "CRM Orum",
    "files": ["main.js", "whisper.js", "setup.js", "preload-crm.js", "preload-call.js", "call.html", "call.js", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": ["nsis"], "icon": "build/icon.png", "artifactName": "CRM-Orum-Setup.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "CRM Orum" },
    "publish": [{ "provider": "github", "owner": "jumune", "repo": "crm-orum-desktop", "releaseType": "release" }]
  }
}
